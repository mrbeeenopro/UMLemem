--- a/arch/um/os-Linux/mem.c
+++ b/arch/um/os-Linux/mem.c
@@ -15,2 +15,3 @@
 #include <sys/vfs.h>
+#include <sys/syscall.h>
 #include <linux/magic.h>
@@ -182,1 +183,18 @@
 #define TEMPNAME_TEMPLATE "/vm_file-XXXXXX"
+
+#ifndef SYS_memfd_create
+#ifdef __NR_memfd_create
+#define SYS_memfd_create __NR_memfd_create
+#else
+#define SYS_memfd_create 319
+#endif
+#endif
+
+static int __init create_tmp_file(unsigned long long len)
+{
+	int fd = -1, err;
+
+	if (tempdir == NULL)
+		tempdir = choose_tempdir();
+
+#ifdef SYS_memfd_create
+	fd = syscall(SYS_memfd_create, "uml_physmem", 0);
+	if (fd >= 0) {
+		if (ftruncate(fd, len) == 0) {
+			posix_fallocate(fd, 0, len);
+			os_info("create_tmp_file: memfd_create len=%llu OK\n", len);
+			return fd;
+		}
+		close(fd);
+		fd = -1;
+	}
+#endif
+
+	fd = make_tempfile(TEMPNAME_TEMPLATE);
--- a/arch/um/os-Linux/signal.c
+++ b/arch/um/os-Linux/signal.c
@@ -31,1 +31,1 @@
-	[SIGBUS]	= relay_signal,
+	[SIGBUS]	= bus_handler,
@@ -42,1 +42,1 @@
-	if (sig == SIGSEGV) {
+	if (sig == SIGSEGV || sig == SIGBUS) {
--- a/arch/um/kernel/trap.c
+++ b/arch/um/kernel/trap.c
@@ -8,1 +8,2 @@
 #include <linux/sched/signal.h>
+#include <linux/sched/task.h>
+
+void bus_handler(int sig, struct siginfo *si, struct uml_pt_regs *regs,
+		 void *mc)
+{
+	int code = si ? si->si_code : BUS_ADRERR;
+	unsigned long addr = si ? (unsigned long)si->si_addr : 0;
+	unsigned long ip = regs ? UPT_IP(regs) : 0;
+
+	if (regs && UPT_IS_USER(regs)) {
+		struct faultinfo *fi = UPT_FAULTINFO(regs);
+		current->thread.arch.faultinfo = *fi;
+		force_sig_fault(SIGBUS, code ? code : BUS_ADRERR, (void __user *)addr);
+		return;
+	}
+
+	if (regs && arch_fixup(ip, regs))
+		return;
+
+	if (current && current->thread.segv_continue && mc) {
+		mc_set_rip(mc, current->thread.segv_continue);
+		current->thread.segv_continue = NULL;
+		return;
+	}
+
+	if (current && current->pid > 1) {
+		printk(KERN_ERR "UML: Process %s[%d] killed due to SIGBUS at ip %lx, addr %lx\n",
+		       current->comm, current->pid, ip, addr);
+		force_sig_fault(SIGBUS, code ? code : BUS_ADRERR, (void __user *)addr);
+		make_task_dead(SIGBUS);
+	}
+
+	printk(KERN_ERR "Bus error in kernel: signo=%d, code=%d, errno=%d, addr=%lx, ip=%lx\n",
+	       si ? si->si_signo : 7, code, si ? si->si_errno : 0, addr, ip);
+	panic("Kernel mode signal 7 (SIGBUS)");
+}
